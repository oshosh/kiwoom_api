## AdSense (build-time injection)
#
# ADSENSE_ENABLE
# - true/false (default: false)
ADSENSE_ENABLE=false
#
# ADSENSE_CLIENT
# - Example: ca-pub-1234567890123456
ADSENSE_CLIENT=
#
# ADSENSE_SLOT
# - Numeric ad slot id from AdSense
ADSENSE_SLOT=
#
# ADSENSE_PUB_ID
# - pub id for ads.txt (with or without "pub-")
ADSENSE_PUB_ID=
#
# ADS_TXT_LINE (optional)
# - If you want to paste the exact ads.txt line from AdSense, put it here.
ADS_TXT_LINE=

